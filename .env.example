# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=https://your-domain.com   # Public URL (ngrok in dev, your server in prod)

# ─── Twilio (AI agent phone — business forwards missed calls here) ────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx        # Your Twilio number

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4.1-mini               # Live conversation: speed matters most (gpt-4.1 / gpt-4o if it slips up)
EXTRACTION_MODEL=gpt-4.1                # Post-call extraction: accuracy matters most, runs once per call
WHISPER_MODEL=gpt-4o-transcribe         # Post-call audio transcription (whisper-1 is noticeably worse on phone audio)

# ─── Persona & Voice ──────────────────────────────────────────────────────────
PERSONA_NAME=Maya                       # The receptionist introduces itself with this name

# Conversation mode:
#   true  = ConversationRelay (recommended): streaming, ElevenLabs voice,
#           Deepgram transcription, callers can interrupt mid-sentence
#   false = classic Gather/Say webhooks (Polly Generative voice)
USE_CONVERSATION_RELAY=true

# ConversationRelay voice (ElevenLabs voice ID; default "Amelia", British female)
RELAY_TTS_PROVIDER=ElevenLabs
RELAY_VOICE=ZF6FPAbjXT4488VcRRnw
RELAY_TRANSCRIPTION_PROVIDER=Deepgram
RELAY_SPEECH_MODEL=nova-3-general       # nova-3 is much better than nova-2 on names, emails and digits

# Webhook-mode voice (any Twilio <Say> voice)
#   British female: Polly.Amy-Generative   | US female: Polly.Joanna-Generative
#   US male: Polly.Matthew-Generative      | Google: Google.en-GB-Chirp3-HD-Aoede
TTS_VOICE=Polly.Amy-Generative
TTS_LANGUAGE=en-GB

# Webhook-mode live speech recognition
SPEECH_MODEL=deepgram_nova-2            # far more accurate than phone_call
SPEECH_TIMEOUT=2                        # seconds of silence that ends an utterance
SPEECH_HINTS=                           # extra comma-separated vocabulary (names, products)

# ─── Call Recording ───────────────────────────────────────────────────────────
# Records calls for accurate post-call transcription. The greeting includes a
# "this call may be recorded" disclosure when enabled — check the consent rules
# for your jurisdiction before changing this.
RECORD_CALLS=true
# Post-call processing waits this long (ms) for the recording so the summary
# email is built from the accurate audio transcript. 0 = don't wait.
RECORDING_WAIT_MS=25000

# ─── Call Limits ──────────────────────────────────────────────────────────────
LLM_TIMEOUT_MS=8000                     # Per live-turn LLM request; fail fast instead of dead air
SILENCE_TIMEOUT_S=12                    # Silence before "are you still there?"; same again ends the call
MAX_CALL_DURATION_S=600                 # Hard cap on call length
SHUTDOWN_TIMEOUT_MS=25000               # SIGTERM waits this long for live calls + pending emails

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com                 # Your Gmail address
SMTP_PASS=abcd efgh ijkl mnop           # Gmail App Password (16 chars)
EMAIL_FROM_NAME=AI Receptionist
BUSINESS_EMAIL=reception@business.com   # Where call summaries are sent

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ai_receptionist

# ─── Company ───────────────────────────────────────────────────────────────────
COMPANY_NAME=Acme Corporation
COMPANY_TIMEZONE=America/New_York

# ─── Optional: Slack Alerts ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Optional: SMS Alerts (urgent calls) ───────────────────────────────────────
ALERT_SMS_NUMBER=+1xxxxxxxxxx  # Number to SMS for urgent calls

# ─── Security ──────────────────────────────────────────────────────────────────
# Bearer token for the admin API (/api/calls/*). The admin API is disabled
# without it, in every environment.
#   curl -H "Authorization: Bearer $ADMIN_API_KEY" $BASE_URL/api/calls
ADMIN_API_KEY=change-me-to-a-long-random-string
# Accept unsigned Twilio webhooks — only for local curl testing (ngrok works
# with validation on). Startup is refused in production when true.
SKIP_TWILIO_SIGNATURE=false
